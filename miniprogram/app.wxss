/* Activity footer: circular share action + pill reservation action. */
.bottom-action{display:flex;align-items:center;gap:24rpx;padding:20rpx 54rpx calc(20rpx + env(safe-area-inset-bottom));box-shadow:0 -2rpx 10rpx rgba(0,0,0,.04)}
.bottom-action .share-button{flex:0 0 112rpx;width:112rpx;height:112rpx;padding:0;margin:0;border-radius:50%;background:#f0e7d6;display:flex;align-items:center;justify-content:center}
.share-button image{width:52rpx;height:52rpx}
.bottom-action .gold-button{flex:1;min-width:0;width:auto;height:112rpx;margin:0;padding:0 20rpx;border-radius:999rpx;background:#f0e7d6;color:#25251f;font-size:36rpx;font-weight:400;display:flex;align-items:center;justify-content:center}

/* Keep the confirmation action outside the independently scrolling choices. */
.slots-sheet{height:86vh;max-height:86vh;display:flex;flex-direction:column;padding-bottom:0}
.slots-sheet .handle,.slots-sheet .sheet-header{flex-shrink:0}
.slots-sheet .sheet-scroll{flex:1;height:0;min-height:0;max-height:none}
.slot-footer{flex-shrink:0;background:#fff;padding:36rpx 14rpx calc(20rpx + env(safe-area-inset-bottom))}
.slot-footer .gold-button{height:112rpx;margin:0;padding:0 24rpx;border-radius:999rpx;background:#f0e7d6;color:#161616;font-size:36rpx;font-weight:400;display:flex;align-items:center;justify-content:center}

/* Match the supplied booking sheet reference. */
.slots-sheet{height:92vh;max-height:92vh;padding:18rpx 50rpx 0;border-radius:32rpx 32rpx 0 0;color:#111}
.slots-sheet .handle{width:146rpx;height:10rpx;background:#a0a0a0;margin-bottom:42rpx}
.slots-sheet .sheet-header{font-size:34rpx;margin-bottom:20rpx}
.slots-sheet .close{font-size:34rpx;color:#a0a0a0}
.slots-sheet .slot-hint{font-size:21rpx;color:#999;border-bottom:1rpx solid #e4e4e4;padding-bottom:28rpx;line-height:1.6}
.slots-sheet .section-title{font-size:32rpx;margin:48rpx 0 26rpx;color:#111}
.slots-sheet .choices{gap:22rpx 12rpx}
.slots-sheet .choices button{width:100%;min-height:70rpx;margin:0;padding:14rpx 5rpx;border:1rpx solid #a6a6a6;border-radius:12rpx;color:#999;background:#fff;font-size:26rpx;font-weight:400;line-height:1.3}
.slots-sheet .choices .selected{border-color:#111;color:#111;background:#fff}
.slots-sheet .choices .experience-en{font-size:26rpx;margin-top:2rpx;line-height:1.35}
.slots-sheet .choices .visit-note{font-size:16rpx;white-space:nowrap;margin-top:8rpx}
.slots-sheet .slot-footer{padding:28rpx 0 calc(16rpx + env(safe-area-inset-bottom))}
.slots-sheet .slot-footer .gold-button{height:112rpx;width:100%;margin:0;border:0;border-radius:999rpx;background:#f0e7d7;color:#111;font-size:38rpx;font-weight:400;line-height:1;box-shadow:none}

/* Reservation form submit button only. */
.gold-button.booking-submit{width:100%;height:112rpx;padding:0 24rpx;border:0;border-radius:999rpx;background:#f0e7d7;color:#111;font-size:38rpx;font-weight:400;line-height:1;box-shadow:none;display:flex;align-items:center;justify-content:center}

/* Shared cancel placement and touch target for every bottom sheet. */
.sheet{padding-top:18rpx;padding-left:50rpx;padding-right:50rpx}
.sheet .handle{width:146rpx;height:10rpx;margin:0 auto 42rpx;border-radius:8rpx;background:#a0a0a0}
.sheet .sheet-header{min-height:68rpx;align-items:flex-start;gap:20rpx}
.sheet .sheet-header>text:first-child{flex:1;min-width:0;padding-top:8rpx;line-height:52rpx}
.sheet .sheet-header .close{flex:0 0 88rpx;width:88rpx;height:68rpx;font-size:34rpx;font-weight:400;line-height:52rpx;color:#a0a0a0;display:flex;align-items:center;justify-content:flex-end}


/* Gender picker: value left, chevron at the right edge. */
.field .gender-picker{display:flex;align-items:center;justify-content:space-between;gap:24rpx;padding-right:30rpx}
.gender-chevron{flex-shrink:0;width:16rpx;height:16rpx;margin-top:-8rpx;border-right:3rpx solid #a0a0a0;border-bottom:3rpx solid #a0a0a0;transform:rotate(45deg)}
