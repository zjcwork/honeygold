.navigation{position:fixed;top:0;left:0;right:0;z-index:8;background:#fff;color:#111;box-sizing:border-box}.navigation-row{position:relative;display:flex;align-items:center}.navigation-back{position:absolute;left:8px;top:50%;transform:translateY(-50%);width:44px;height:44px;margin:0;padding:0;border:0;background:transparent;display:flex;align-items:center;justify-content:center}.navigation-back::after{border:none}.chevron{width:10px;height:10px;border-left:2px solid #111;border-bottom:2px solid #111;transform:rotate(45deg)}.navigation-title{position:absolute;text-align:center;font-size:16px;line-height:24px;font-weight:400;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;pointer-events:none}
