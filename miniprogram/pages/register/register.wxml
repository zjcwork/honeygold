<app-navigation title="报名信息" show-back="{{true}}" bindback="navigationBack" />
<view class="registration-page">
<view class="title">填写报名信息</view>
<view wx:if="{{errorMessage}}" class="registration-error">{{errorMessage}}</view>
<view wx:if="{{event}}">
<view class="registration-event"><image wx:if="{{event.cover_image}}" class="event-cover-image" src="{{event.cover_image}}" mode="aspectFill"/><view wx:else class="event-cover-image image-placeholder"/><view class="event-info"><view class="subtitle">{{event.subtitle}}</view><view class="event-title">{{event.title}}</view><view class="event-desc">{{event.description}}</view><view class="meta"><image class="meta-icon" src="/assets/ui/time.png" mode="aspectFit"/>{{selectedDate}} {{selectedTime}}</view><view class="meta"><image class="meta-icon" src="/assets/ui/location.png" mode="aspectFit"/>{{event.location}}</view><text class="badge">{{isFull?'名额已满':'预约中'}} ›</text></view></view>
<view class="registration-selection" wx:for="{{selectedSlots}}" wx:key="selectionKey">{{item.experience_label||item.experience}} · {{item.date}} {{item.time}} {{item.booked>=item.capacity?'（已满）':''}}</view>
<view class="field">手机号 *<view class="registration-phone-row"><input placeholder-class="registration-input-placeholder" disabled value="{{phone}}" placeholder="请授权微信手机号"/><button class="phone-authorize-button" open-type="getPhoneNumber" bindgetphonenumber="getPhone">手机号快捷授权</button></view></view><view class="field">真实姓名 *<input placeholder-class="registration-input-placeholder" placeholder="请输入姓名" maxlength="40" value="{{name}}" data-field="name" bindinput="input"/></view><view class="field">生日 *<picker mode="date" value="{{birthday||today}}" end="{{today}}" bindchange="birthdayChange"><view class="picker gender-picker"><text>{{birthday||'请选择生日'}}</text><view class="gender-chevron"/></view></picker></view><view class="field">性别 *<picker range="{{genders}}" bindchange="genderChange"><view class="picker gender-picker"><text>{{gender||'请选择性别'}}</text><view class="gender-chevron" /></view></picker></view><checkbox-group bindchange="consent"><label class="consent"><checkbox value="terms" checked="{{terms}}" color="#1A4D3F"/><view>我已阅读并同意<text class="link" data-type="terms" catchtap="showTerms">使用条款</text>、<text class="link" data-type="booking" catchtap="showTerms">预约须知</text>和<text class="link" data-type="privacy" catchtap="showTerms">隐私说明</text></view></label><label class="consent"><checkbox value="photo" checked="{{photo}}" color="#1A4D3F"/><view>我同意蜜金拍摄与我相关的活动照片视频，并在品牌平台发布（可选）。</view></label></checkbox-group><button class="gold-button booking-submit" disabled="{{busy||!terms}}" loading="{{busy}}" bindtap="submit">{{booking?'查看报名结果':'提交预约'}}</button></view><view wx:elif="{{!errorMessage}}" class="empty">正在加载报名信息…</view>

</view>
<view wx:if="{{successOpen}}" class="booking-success-mask" catchtap="noop"><view class="booking-success-dialog"><button class="booking-success-close" bindtap="closeSuccess">取消</button><image class="booking-success-check" src="/assets/ui/booking-success.png" mode="aspectFit"/><view class="booking-success-title">{{successTitle}}</view><view wx:if="{{successNote}}" class="booking-success-note">{{successNote}}</view><view class="booking-success-actions"><button open-type="share">邀请好友探索</button><button bindtap="viewBooking">查看报名信息</button></view></view></view>
