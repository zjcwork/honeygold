<app-navigation title="报名信息" show-back="{{true}}" bindback="navigationBack" />
<view class="registration-page">
<view class="title">填写报名信息</view>
<view wx:if="{{errorMessage}}" class="registration-error">{{errorMessage}}</view>
<view wx:if="{{event}}">
<view class="registration-event"><image wx:if="{{event.cover_image}}" class="event-cover-image" src="{{event.cover_image}}" mode="aspectFill"/><view wx:else class="cover"><text>HONEY GOLD
CLUB</text><view>海岛<view>漫游记</view></view></view><view class="event-info"><view class="subtitle">{{event.subtitle}}</view><view class="event-title">{{event.title}}</view><view class="event-desc">{{event.description}}</view><view class="meta">◷ {{selectedDate}} {{selectedTime}}</view><view class="meta">⌖ {{event.location}}</view><text class="badge">{{isFull?'候补报名':'预约中'}} ›</text></view></view>
<view class="registration-selection">{{selectedType}}</view>
<view class="field">手机号 *<view class="registration-phone-row"><input placeholder-class="registration-input-placeholder" disabled value="{{phone}}" placeholder="请授权微信手机号"/><button class="phone-authorize-button" open-type="getPhoneNumber" bindgetphonenumber="getPhone">手机号快捷授权</button></view></view><view class="field">真实姓名 *<input placeholder-class="registration-input-placeholder" placeholder="请输入姓名" maxlength="40" value="{{name}}" data-field="name" bindinput="input"/></view><view class="field">性别 *<picker range="{{genders}}" bindchange="genderChange"><view class="picker gender-picker"><text>{{gender}}</text><view class="gender-chevron" /></view></picker></view><checkbox-group bindchange="consent"><label class="consent"><checkbox value="terms" checked="{{terms}}" color="#315c3f"/><view>我已阅读并同意<text class="link" data-type="terms" catchtap="showTerms">使用条款</text>、<text class="link" data-type="booking" catchtap="showTerms">预约须知</text>和<text class="link" data-type="privacy" catchtap="showTerms">隐私说明</text></view></label><label class="consent"><checkbox value="photo" checked="{{photo}}" color="#315c3f"/><view>我同意蜜金拍摄与我相关的活动照片视频，并在品牌平台发布（可选）。</view></label></checkbox-group><button class="gold-button booking-submit" disabled="{{busy||!terms}}" loading="{{busy}}" bindtap="submit">{{booking?'查看报名结果':'提交预约'}}</button></view><view wx:elif="{{!errorMessage}}" class="empty">正在加载报名信息…</view>

</view>
<view wx:if="{{successOpen}}" class="booking-success-mask" catchtap="noop"><view class="booking-success-dialog"><button class="booking-success-close" bindtap="closeSuccess">取消</button><view class="booking-success-check">✓</view><view class="booking-success-title">{{booking.status==='waitlisted'?'候补提交成功':'报名成功'}}</view><view wx:if="{{booking.status==='waitlisted'}}" class="booking-success-note">当前名额已满，请等待递补</view><view class="booking-success-actions"><button bindtap="subscribeSuccess" loading="{{subscribing}}">订阅活动通知</button><button bindtap="viewBooking">查看报名信息</button></view></view></view>
