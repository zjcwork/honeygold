<app-navigation title="{{view==='detail'?'活动详情':view==='ticket'?'预约详情':view==='mine'?'我的活动':'蜜金 HONEY GOLD'}}" show-back="{{view==='detail'||view==='ticket'}}" bindback="navigationBack" />
<view class="page">
<view wx:if="{{view==='home'}}">
<view wx:if="{{splash}}" class="launch-screen"><image src="{{splash.image}}" mode="aspectFill" data-event="{{splash.eventId}}" bindtap="contentTap" binderror="skipSplash"/><button class="launch-skip" bindtap="skipSplash">跳过 {{splashRemaining}}s</button></view>
<swiper wx:if="{{slides.length}}" class="home-carousel" autoplay="{{slides.length>1}}" circular indicator-dots="{{slides.length>1}}" interval="4000"><swiper-item wx:for="{{slides}}" wx:key="index"><image src="{{item.image}}" mode="aspectFill" data-event="{{item.eventId}}" bindtap="contentTap"/></swiper-item></swiper>
<view wx:else class="hero"><view class="english">HONEY GOLD<view>CLUB</view></view><view class="brandline">蜜金 · 海岛漫游记</view><view class="hero-title">把日常留在岸上<view>向美好出发。</view></view><view class="hero-date">SHANGHAI · OCTOBER 2026</view></view>
<view class="tabs"><button class="{{filter==='all'?'on':''}}" data-value="all" bindtap="setFilter">全部活动</button><button class="{{filter==='published'?'on':''}}" data-value="published" bindtap="setFilter">进行中</button><button class="{{filter==='ended'?'on':''}}" data-value="ended" bindtap="setFilter">已结束</button></view>
<view class="list"><view class="event" wx:for="{{visibleEvents}}" wx:key="id" data-id="{{item.id}}" bindtap="openEvent"><image wx:if="{{item.cover_image}}" class="event-cover-image" src="{{item.cover_image}}" mode="aspectFill"/><view wx:else class="cover"><text>HONEY GOLD\nCLUB</text><view>海岛<view>漫游记</view></view><text class="cover-label">蜜金</text></view><view class="event-info"><view class="subtitle">{{item.subtitle}}</view><view class="event-title">{{item.title}}</view><view wx:if="{{item.summary}}" class="event-desc">{{item.summary}}</view><view class="meta">◷ {{item.start_date}} — {{item.end_date}}</view><view class="meta">⌖ {{item.location}}</view><text class="badge">{{item.label}} ›</text></view></view><view wx:if="{{!visibleEvents.length}}" class="empty">暂无相关活动</view></view>
</view>
<view wx:if="{{view==='detail'}}"><image wx:if="{{event.hero_image}}" class="event-hero-image" src="{{event.hero_image}}" mode="widthFix"/><view wx:else class="detail-hero"><view class="english">HONEY GOLD CLUB</view><view class="detail-title">{{event.title}}</view><view>一场逃离城市的黄金假日</view></view><view class="body"><text class="badge">{{event.label}}</text><view class="title">{{event.title}}</view><view class="meta">◷ {{event.start_date}} 至 {{event.end_date}}</view><view class="meta">⌖ {{event.location}}</view><view class="section-title">活动介绍</view><text className="description">{{event.description}}</text><block wx:if="{{event.notices}}"><view class="section-title">活动须知</view><text class="description">{{event.notices}}</text></block></view><view class="bottom-action"><button class="share-button" open-type="share" aria-label="分享活动"><image src="/assets/share.svg" mode="aspectFit" /></button><button class="gold-button" disabled="{{event.status!=='published'}}" bindtap="reserve">{{event.status==='published'?'预约登岛':'活动已结束'}}</button></view></view>
<view wx:if="{{view==='mine'}}" class="mine"><view class="subtitle">MY ISLAND MOMENTS</view><view class="title">我的活动</view><view class="muted">收藏每一次与蜜金的相遇。</view><view class="tabs"><button class="{{filter==='all'?'on':''}}" data-value="all" bindtap="setFilter">全部</button><button class="{{filter==='confirmed'?'on':''}}" data-value="confirmed" bindtap="setFilter">进行中</button><button class="{{filter==='waitlisted'?'on':''}}" data-value="waitlisted" bindtap="setFilter">候补中</button><button class="{{filter==='ended'?'on':''}}" data-value="ended" bindtap="setFilter">已结束</button><button class="{{filter==='cancelled'?'on':''}}" data-value="cancelled" bindtap="setFilter">已取消</button></view><view class="booking" wx:for="{{visibleBookings}}" wx:key="id" data-id="{{item.id}}" bindtap="selectBooking"><text class="badge">{{item.label}}</text><view class="event-title">{{item.title}}</view><view class="meta">{{item.experience}}</view><view class="meta">{{item.date}} · {{item.time}}</view><view class="booking-link">查看预约 →</view></view><view wx:if="{{!visibleBookings.length}}" class="empty">还没有相关预约<view class="muted">下一场美好，等你登岛。</view><button class="gold-button" bindtap="home">去看看活动</button></view></view>
<view wx:if="{{view==='ticket'}}" class="ticket-page registration-success">
<view class="success-heading"><view class="title">{{booking.status==='confirmed'?'报名成功！':booking.label}}</view><view class="success-event-name">{{booking.subtitle}} 活动预约</view><view class="muted">{{booking.status==='waitlisted'?'名额释放后按报名顺序递补，请留意我的活动':'抵达活动现场，请出示专属活动二维码'}}</view></view>
<view class="section-title">报名场次</view><view class="ticket"><view class="event-title">{{booking.title}}</view><view wx:if="{{booking.experience}}" class="ticket-line"><text>参与体验</text><text>{{booking.experience}}</text></view><view class="ticket-line"><text>预约时间</text><text>{{booking.date}} {{booking.time}}</text></view><view class="ticket-line"><text>活动地点</text><text>{{booking.location}}</text></view><view class="section-title">报名信息</view><view class="ticket-line"><text>姓名</text><text>{{booking.name}}</text></view><view class="ticket-line"><text>手机号</text><text>{{booking.maskedPhone}}</text></view><canvas wx:if="{{qr}}" canvas-id="ticketQR" class="qr" style="width:220px;height:220px"/><view wx:if="{{qr}}" class="ticket-code" bindtap="copyTicketCode"><view>入场凭证编号</view><text selectable>HG:{{booking.code}}</text><view class="ticket-code-hint">点击复制凭证编号</view></view><view wx:if="{{booking.status==='confirmed'||booking.status==='waitlisted'}}" class="ticket-actions"><button bindtap="reschedule">更改场次</button><button bindtap="cancel">取消报名</button></view></view>
<block wx:if="{{booking.description}}"><view class="section-title">活动介绍</view><text class="description">{{booking.description}}</text></block><block wx:if="{{booking.notices}}"><view class="section-title">活动须知</view><text class="description">{{booking.notices}}</text></block>
<view wx:if="{{booking.contact_qr||booking.contact_wechat}}" class="success-contact"><image wx:if="{{booking.contact_qr}}" src="{{booking.contact_qr}}" mode="aspectFit" show-menu-by-longpress/><view class="muted">添加小助手微信<view>了解更多活动详情</view></view><button wx:if="{{booking.contact_wechat}}" class="plain-button" bindtap="copyContact">微信：{{booking.contact_wechat}} · 复制</button><button wx:if="{{booking.contact_qr}}" class="gold-button" bindtap="saveContact">保存客服二维码</button></view>
<button wx:if="{{qr}}" class="gold-button" bindtap="saveTicket">保存入场凭证</button><button wx:if="{{booking.status==='confirmed'||booking.status==='waitlisted'}}" class="plain-button" bindtap="subscribe">订阅活动通知</button></view>
<view wx:if="{{view==='home'||view==='mine'}}" class="tabbar"><view class="{{tab==='events'?'active':''}}" bindtap="home"><view>▣</view>活动中心</view><view class="{{tab==='mine'?'active':''}}" bindtap="loadMine"><view>♙</view>我的活动</view></view>
<view wx:if="{{sheet}}" class="mask" bindtap="closeSheet"><view class="sheet {{sheet==='slots'?'slots-sheet':''}}" catchtap="noop"><view class="handle"/><view class="sheet-header"><text>{{sheet==='slots'?'选择你的登岛方式':sheet==='form'?'填写报名信息':sheet==='member'?'登录后继续预约':'预约条款与隐私说明'}}</text><text class="close" bindtap="closeSheet">取消</text></view><scroll-view scroll-y enhanced="{{true}}" show-scrollbar="{{false}}" class="sheet-scroll">
<view wx:if="{{sheet==='slots'}}"><view wx:if="{{types.length > 1 || types[0]}}"><view class="muted slot-hint">*每场活动仅可预约一种体验，如需更换请取消后重新预约</view><view class="section-title">选择场次</view><view class="choices"><button wx:for="{{types}}" wx:key="*this" class="{{selectedType===item?'selected':''}}" data-value="{{item}}" bindtap="chooseType"><text>{{item==='鎏金美甲 Beauty Bar'?'鎏金美甲':item==='微醺特调 Gold Bar'?'微醺特调':(item||'无体验')}}</text><view class="experience-en {{item==='仅登岛参观'?'visit-note':''}}">{{item==='鎏金美甲 Beauty Bar'?'Beauty Bar':item==='微醺特调 Gold Bar'?'Gold Bar':item==='仅登岛参观'?'自由观展 + 迎宾区护照领取':''}}</view></button></view></view><view class="section-title">选择日期</view><view class="choices"><button wx:for="{{dates}}" wx:key="value" class="{{selectedDate===item.value?'selected':''}}" data-value="{{item.value}}" bindtap="chooseDate">{{item.label}}</button></view><view class="section-title">选择时间</view><view class="choices"><button wx:for="{{times}}" wx:key="id" class="{{slotId===item.id?'selected':''}}" disabled="{{item.past}}" data-id="{{item.id}}" bindtap="chooseTime">{{item.time}}<view wx:if="{{item.full}}">已满 · 可候补</view></button></view></view>
<view wx:if="{{sheet==='member'}}"><text class="description">请选择微信登录或微信手机号授权，登录后继续填写报名信息。</text><checkbox-group bindchange="memberChange"><label class="consent"><checkbox value="yes" color="#315c3f" checked="{{memberConsent}}"/><view>我已阅读并同意<text class="link" catchtap="showTerms">隐私说明及会员规则</text></view></label></checkbox-group><button class="gold-button" disabled="{{!memberConsent}}" bindtap="memberLogin">{{demo?'演示登录并继续':'微信登录并继续'}}</button><button wx:if="{{!demo}}" class="plain-button" open-type="getPhoneNumber" disabled="{{busy||!memberConsent}}" bindgetphonenumber="phoneLogin">微信手机号授权登录</button></view>
<view wx:if="{{sheet==='terms'}}"><text class="description">此为演示条款，正式上线需品牌确认。\n\n活动预约免费。每场活动仅可预约一种体验。满额可候补，名额释放后按顺序递补。请提前 8 小时修改或取消，并提前 15 分钟到场。\n\n报名姓名、手机号、性别用于预约、会员记录和现场核销。管理员可以查看和导出报名信息。入场二维码仅供本人使用。\n\n拍摄授权独立选择，不影响预约资格。未授权拍摄的嘉宾请到场时告知工作人员。\n\n个人信息更正、删除及撤回授权请联系现场品牌工作人员。正式上线前应补充隐私联系人、联系方式、数据保存期限及品牌会员规则。\n\n未成年人请由监护人报名并陪同参加。</text><button class="gold-button" bindtap="backTerms">我已阅读，返回</button></view>
</scroll-view><view wx:if="{{sheet==='slots'}}" class="slot-footer"><button class="gold-button" loading="{{busy}}" disabled="{{!slotId||busy}}" bindtap="confirmSlot">{{isFull?'预约已满 / 提交候补':changing?'确认改签':'确认预约'}}</button></view></view></view><canvas canvas-id="poster" style="position:fixed;left:-1000px;top:0;width:600px;height:880px"/>
</view>
