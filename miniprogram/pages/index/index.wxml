<app-navigation overlay="{{view==='ticket'}}" title="{{view==='detail'?'活动详情':view==='ticket'?'':view==='mine'?'':'蜜金 HONEY GOLD'}}" show-back="{{view==='detail'||view==='ticket'}}" bindback="navigationBack" />
<view class="page">
<view wx:if="{{view==='home'}}">
<view wx:if="{{splash}}" class="launch-screen"><image src="{{splash.image}}" mode="aspectFill" data-event="{{splash.eventId}}" bindtap="contentTap" binderror="skipSplash"/><button class="launch-skip" style="top:{{splashSkipTop}}px" catchtap="skipSplash">跳过 {{splashRemaining}}s</button></view>
<swiper wx:if="{{slides.length}}" class="home-carousel" autoplay="{{slides.length>1}}" circular indicator-dots="{{slides.length>1}}" interval="4000"><swiper-item wx:for="{{slides}}" wx:key="index"><image src="{{item.image}}" mode="aspectFill" data-event="{{item.eventId}}" bindtap="contentTap"/></swiper-item></swiper>
<view wx:else class="hero"><view class="english">HONEY GOLD<view>CLUB</view></view><view class="brandline">蜜金 · 海岛漫游记</view><view class="hero-title">把日常留在岸上<view>向美好出发。</view></view><view class="hero-date">SHANGHAI · OCTOBER 2026</view></view>
<view class="tabs"><button class="{{filter==='all'?'on':''}}" data-value="all" bindtap="setFilter">全部活动</button><button class="{{filter==='published'?'on':''}}" data-value="published" bindtap="setFilter">进行中</button><button class="{{filter==='ended'?'on':''}}" data-value="ended" bindtap="setFilter">已结束</button></view>
<view class="list"><view class="event" wx:for="{{visibleEvents}}" wx:key="id" data-id="{{item.id}}" bindtap="openEvent"><image wx:if="{{item.cover_image}}" class="event-cover-image" src="{{item.cover_image}}" mode="aspectFill"/><view wx:else class="event-cover-image image-placeholder"/><view class="event-info"><view class="subtitle">{{item.subtitle}}</view><view class="event-title">{{item.title}}</view><view wx:if="{{item.summary}}" class="event-desc">{{item.summary}}</view><view class="meta"><image class="meta-icon" src="/assets/ui/time.png" mode="aspectFit"/>{{item.start_date}} — {{item.end_date}}</view><view class="meta"><image class="meta-icon" src="/assets/ui/location.png" mode="aspectFit"/>{{item.location}}</view><text class="badge">{{item.label}} ›</text></view></view><view wx:if="{{!visibleEvents.length}}" class="empty">暂无相关活动</view></view>
</view>
<view wx:if="{{view==='detail'}}"><image wx:if="{{event.hero_image}}" class="event-hero-image" src="{{event.hero_image}}" mode="widthFix"/><view wx:else class="detail-image-placeholder"/><view class="body"><text class="badge">{{event.label}}</text><view class="title">{{event.title}}</view><view class="meta"><image class="meta-icon" src="/assets/ui/time.png" mode="aspectFit"/>{{event.start_date}} 至 {{event.end_date}}</view><view class="meta"><image class="meta-icon" src="/assets/ui/location.png" mode="aspectFit"/>{{event.location}}</view><view class="section-title">活动介绍</view><view class="description"><text wx:for="{{event.descriptionLines}}" wx:key="index" class="description-line {{item.heading?'description-heading':''}}">{{item.text}}</text></view><block wx:if="{{event.notices}}"><view class="section-title">活动须知</view><text class="description">{{event.notices}}</text></block></view><view class="bottom-action"><button class="share-button" open-type="share" aria-label="分享活动"><image src="/assets/share.svg" mode="aspectFit" /></button><button class="gold-button" disabled="{{eventBooked||bookingStatusLoading||event.status!=='published'}}" bindtap="reserve">{{eventBooked?'已预约':bookingStatusLoading?'加载中…':event.status==='published'?'预约登岛':'活动已结束'}}</button></view></view>
<view wx:if="{{view==='mine'}}" class="mine mine-list-page">
<view class="mine-header">
<view class="mine-header-title">我的活动</view>
<view class="mine-header-description">HONEY GOLD MEMBER</view>
</view>
<view class="tabs"><button class="{{filter==='ongoing'?'on':''}}" data-value="ongoing" bindtap="setFilter">进行中</button><button class="{{filter==='history'?'on':''}}" data-value="history" bindtap="setFilter">历史活动</button></view>
<view class="list"><view class="event mine-event" wx:for="{{visibleBookings}}" wx:key="id" data-id="{{item.id}}" bindtap="selectBooking"><image wx:if="{{item.cover_image}}" class="event-cover-image" src="{{item.cover_image}}" mode="aspectFill"/><view wx:else class="mine-cover-placeholder"/><view class="event-info"><view class="subtitle">{{item.subtitle}}</view><view class="event-title">{{item.title}}</view><view wx:if="{{item.summary}}" class="event-desc">{{item.summary}}</view><view class="meta"><image class="meta-icon" src="/assets/ui/time.png" mode="aspectFit"/>{{item.dates}}</view><view class="meta"><image class="meta-icon" src="/assets/ui/location.png" mode="aspectFit"/>{{item.location}}</view><text class="badge {{item.activityStatus==='ongoing'?'':'mine-badge-inactive'}}">{{item.activityLabel}}</text></view></view><view wx:if="{{!visibleBookings.length}}" class="empty">{{filter==='history'?'暂无参与过的活动':'暂无进行中的活动'}}</view></view>
</view>
<view wx:if="{{view==='ticket'}}" class="ticket-page registration-success">
<view class="success-hero {{booking.hero_image?'':'success-hero-placeholder'}}"><image wx:if="{{booking.hero_image}}" src="{{booking.hero_image}}" mode="widthFix"/></view>
<view class="success-content">
<view class="success-heading"><view class="title">{{activityBookingTitle}}</view><view class="success-event-name">{{booking.subtitle||booking.title}} 活动预约</view><view class="arrival-row"><view class="muted">抵达活动现场，<view>须出示专属活动二维码</view></view><button wx:if="{{hasAdmission}}" class="qr-entry" bindtap="openTicketQR" aria-label="查看活动入场二维码"><image src="/assets/ui/qr-entry.png" mode="aspectFit"/></button></view></view>
<view class="section-title">报名场次</view>
<view class="ticket">
<view class="event-title">{{booking.title}}</view>
<view class="participation-name">{{booking.participation_name}}</view>
<view wx:for="{{bookingExperienceRows}}" wx:for-item="entry" wx:key="entryKey" class="success-experience">
<view class="experience-name">{{entry.experienceName}}</view>
<view class="meta"><image class="meta-icon" src="/assets/ui/time.png" mode="aspectFit"/>{{entry.date}}　{{entry.time}}</view><view class="meta"><image class="meta-icon" src="/assets/ui/location.png" mode="aspectFit"/>{{entry.location}}</view>
<view wx:if="{{entry.status!=='confirmed'}}" class="meta">{{entry.label}}</view>

</view>
<view class="section-title">报名信息</view><view class="ticket-line"><text>姓名 {{booking.name}}</text></view><view wx:if="{{booking.birthday}}" class="ticket-line"><text>生日 {{booking.birthday}}</text></view><view class="ticket-line"><text>手机号 {{booking.maskedPhone}}</text></view>
<view wx:if="{{canManageActivity}}" class="ticket-actions"><button bindtap="changeActivitySlot">更改场次</button><button bindtap="cancel">取消活动预约</button></view>
</view>
<block wx:if="{{booking.description}}"><view class="section-title long-section-title">活动介绍</view><view class="description"><text wx:for="{{booking.descriptionLines}}" wx:key="index" class="description-line {{item.heading?'description-heading':''}}">{{item.text}}</text></view></block>
<block wx:if="{{booking.notices}}"><view class="section-title long-section-title">活动须知</view><text class="description">{{booking.notices}}</text></block>
<view wx:if="{{booking.contact_qr||booking.contact_wechat}}" class="success-contact"><image wx:if="{{booking.contact_qr}}" src="{{booking.contact_qr}}" mode="aspectFit" show-menu-by-longpress="{{true}}" bindtap="previewContact" aria-label="放大小助手微信二维码"/><view class="muted">扫描添加活动助手<view>了解更多活动详情</view></view><view wx:if="{{booking.contact_qr}}" class="contact-qr-hint">（可点击查看大图）</view><button wx:if="{{booking.contact_wechat&&!booking.contact_qr}}" class="plain-button" bindtap="copyContact">微信：{{booking.contact_wechat}} · 复制</button></view>
</view>
</view>
<view wx:if="{{ticketQROpen}}" class="ticket-qr-mask" catchtap="closeTicketQR"><view class="ticket-qr-dialog" catchtap="noop"><view class="sheet-header"><text>活动入场凭证</text><text bindtap="closeTicketQR">关闭</text></view><scroll-view scroll-y class="ticket-qr-scroll"><view class="meta" wx:for="{{bookingSiblings}}" wx:key="id">{{item.experience_label||item.experience}} · {{item.date}} {{item.time}}<view>{{item.label}}</view></view><canvas wx:if="{{qr}}" canvas-id="ticketQR" class="qr" style="width:220px;height:220px"/><view wx:else class="empty">正在加载入场码…</view><button wx:if="{{qr}}" class="gold-button" bindtap="saveTicket">保存入场凭证</button></scroll-view></view></view>
<view wx:if="{{view==='home'||view==='mine'}}" class="tabbar"><view class="{{tab==='events'?'active':''}}" bindtap="home"><image class="tab-icon" src="/assets/ui/tab-events-{{tab==='events'?'active':'inactive'}}.png" mode="aspectFit"/>活动中心</view><view class="{{tab==='mine'?'active':''}}" bindtap="loadMine"><image class="tab-icon" src="/assets/ui/tab-mine-{{tab==='mine'?'active':'inactive'}}.png" mode="aspectFit"/>我的活动</view></view>
<view wx:if="{{sheet}}" class="mask" bindtap="closeSheet"><view class="sheet {{sheet==='slots'?'slots-sheet':''}}" catchtap="noop"><view class="handle"/><view class="sheet-header"><text>{{sheet==='slots'?'选择您的登岛方式':sheet==='form'?'填写报名信息':'预约条款与隐私说明'}}</text><text class="close" bindtap="closeSheet">取消</text></view><view wx:if="{{sheet==='slots'}}" class="slot-header-note">*两种方式仅可预约一种，如需更换请取消后重新预约</view><scroll-view scroll-y enhanced="{{true}}" show-scrollbar="{{false}}" class="sheet-scroll">
<view wx:if="{{sheet==='slots'}}">
<view class="section-title">选择参与方式</view>
<picker range="{{participationLabels}}" value="{{participationIndex+1}}" disabled="{{changing}}" bindchange="participationChange"><view class="participation-picker">{{participationIndex < 0 ? '请选择参与方式' : participationModes[participationIndex]}}<text>⌄</text></view></picker>
<view wx:for="{{selectionCards}}" wx:for-item="card" wx:for-index="cardIndex" wx:key="name" class="experience-selection">
<view class="section-title">选择日期</view><view class="choices"><button wx:for="{{card.dates}}" wx:key="value" class="{{card.date===item.value?'selected':''}}" data-index="{{cardIndex}}" data-value="{{item.value}}" bindtap="chooseCardDate">{{item.label}}</button></view>
<view wx:if="{{selectedModeKind==='experiences'}}" class="experience-schedule-list">
<view wx:for="{{experienceChoices}}" wx:for-item="experience" wx:for-index="experienceIndex" wx:key="id" wx:if="{{!changing||experience.selected}}" class="experience-schedule">
<view class="experience-options"><button class="experience-toggle {{experience.selected?'selected':''}}" data-index="{{experienceIndex}}" disabled="{{changing}}" bindtap="toggleExperience"><view class="experience-option-title">{{experience.title}}</view><view wx:if="{{experience.description}}" class="experience-option-description">{{experience.description}}</view></button></view>
<view wx:if="{{card.date}}"><view class="section-title">选择时间</view><view class="choices"><button wx:for="{{experience.times}}" wx:key="id" class="{{experience.selected&&experience.slotId===item.id?'selected':''}}" disabled="{{item.past||item.full}}" data-experience="{{experienceIndex}}" data-id="{{item.id}}" bindtap="chooseExperienceTime">{{item.time}}<view wx:if="{{item.full}}">已满</view></button></view></view>
</view></view>
<view wx:elif="{{card.date}}"><view class="section-title">选择时间</view><view class="choices"><button wx:for="{{card.times}}" wx:key="id" class="{{card.slotId===item.id?'selected':''}}" disabled="{{item.past||item.full}}" data-index="{{cardIndex}}" data-id="{{item.id}}" bindtap="chooseCardTime">{{item.time}}<view wx:if="{{item.full}}">已满</view></button></view></view>
</view>
<view wx:if="{{participationIndex>=0&&!selectionCards.length}}" class="muted">暂无可预约场次</view>
</view>

</scroll-view><view wx:if="{{sheet==='slots'}}" class="slot-footer"><button class="gold-button" loading="{{busy}}" disabled="{{!selectionReady||busy}}" bindtap="confirmSlot">{{changing?'确认改签':'确认预约'}}</button></view></view></view><canvas wx:if="{{view==='ticket' && posterReady}}" canvas-id="poster" disable-scroll="{{true}}" style="position:fixed;left:-1000px;top:0;width:600px;height:{{posterHeight||880}}px"/>
</view>
