/* 标注.pdf (375px design): px × 2 = rpx. Font assets are not supplied;
   use Source Han Sans CN when available, then platform CJK sans-serif. */
page{--hg-green:#1A4D3F;--hg-gold:#EEE7D9;--hg-line:#E7E7E7;--hg-muted:#9E9E9E;--hg-ink:#1A1A1A;background:#fff;color:#1A1A1A;font-family:"Source Han Sans CN","SourceHanSansCN","Noto Sans CJK SC","PingFang SC","Microsoft YaHei",sans-serif;font-size:24rpx;font-weight:400;letter-spacing:.5rpx}
button,input,textarea{font-family:inherit;font-weight:400;letter-spacing:inherit}
.muted,.subtitle,.meta,.description{color:#9E9E9E}
.tabs{padding:24rpx 50rpx 20rpx;gap:20rpx;flex-wrap:nowrap}
.tabs button{height:64rpx;min-width:0;margin:0;padding:0 12rpx;border:1rpx solid #9E9E9E;border-radius:40rpx;background:#fff;color:#9E9E9E;display:flex;align-items:center;justify-content:center;font-size:24rpx;font-weight:500;letter-spacing:.5rpx;line-height:36rpx}
.tabs .on{background:#EEE7D9;border-color:#EEE7D9;color:#1A1A1A}
.list{padding:0 50rpx}.event{gap:30rpx;padding:0 0 36rpx;margin-top:20rpx;border-color:#E7E7E7}.event-info{min-width:0}.event-cover-image{width:220rpx;height:360rpx}.event .cover{width:220rpx;min-height:360rpx}
.event-info .subtitle,.event-title{font-size:36rpx;font-weight:500;letter-spacing:.6rpx;line-height:50rpx;color:#1A1A1A}
.event-title{margin:0 0 12rpx}.event-info .subtitle{margin:0}
.event-desc,.event-info .meta{font-size:22rpx;font-weight:400;letter-spacing:.4rpx;line-height:36rpx}
.event-desc{color:#9E9E9E;margin:0 0 12rpx;-webkit-line-clamp:4}.event-info .meta{margin:0;color:#1A1A1A}
.badge{background:#1A4D3F;color:#fff;font-size:22rpx;line-height:30rpx;letter-spacing:.4rpx;padding:2rpx 18rpx;margin-top:8rpx}
.tabbar{border-color:#E7E7E7;padding:16rpx 0 calc(18rpx + env(safe-area-inset-bottom))}
.tabbar>view{font-size:24rpx;line-height:36rpx;font-weight:500;letter-spacing:.5rpx;color:#9E9E9E}.tabbar .active{color:#1A4D3F}.tabbar .tab-icon{display:block;width:40rpx;height:40rpx;margin:0 auto 10rpx}
.gold-button,.plain-button{letter-spacing:.6rpx}.gold-button{background:#EEE7D9;color:#1A1A1A;font-size:36rpx;font-weight:400;line-height:50rpx}.plain-button{color:#1A4D3F}
.bottom-action .gold-button,.slots-sheet .slot-footer .gold-button,.gold-button.booking-submit{background:#EEE7D9;color:#1A1A1A;font-size:36rpx;font-weight:400;letter-spacing:.6rpx;height:112rpx;line-height:50rpx}
.bottom-action .share-button{background:#EEE7D9}
.sheet{color:#1A1A1A}.sheet .handle{background:#9E9E9E}.sheet .sheet-header{font-size:36rpx;font-weight:500;letter-spacing:.6rpx}.sheet .sheet-header .close{font-size:36rpx;font-weight:400;letter-spacing:.6rpx;color:#9E9E9E}
.slots-sheet .section-title{font-size:30rpx;font-weight:400;line-height:44rpx;letter-spacing:.5rpx;color:#1A1A1A;margin:36rpx 0 20rpx}
.slots-sheet .slot-hint,.sheet .muted{font-size:22rpx;font-weight:400;line-height:36rpx;letter-spacing:.4rpx;color:#9E9E9E}
.slots-sheet .choices{gap:20rpx 12rpx}.slots-sheet .choices button{font-size:24rpx;font-weight:500;letter-spacing:.5rpx;line-height:36rpx;min-height:72rpx;padding:16rpx 6rpx;border-color:#9E9E9E;color:#9E9E9E;border-radius:10rpx}.slots-sheet .choices .selected{color:#1A1A1A;border-color:#1A1A1A;background:#fff}
.participation-picker{font-size:30rpx;font-weight:400;letter-spacing:.5rpx;line-height:44rpx;padding:14rpx 20rpx;border-color:#9E9E9E;color:#1A1A1A;margin-bottom:0}
.experience-selection{padding:0 0 28rpx;border-color:#E7E7E7}.experience-options{gap:12rpx;margin-top:24rpx;padding-bottom:12rpx}
.slots-sheet .experience-options .experience-toggle{width:calc((100% - 24rpx) / 3);min-width:0;min-height:96rpx;padding:12rpx 8rpx;border-radius:10rpx;border-color:#9E9E9E;color:#9E9E9E;background:#fff;letter-spacing:.5rpx;font-weight:400}
.experience-option-title{font-size:24rpx;line-height:34rpx;letter-spacing:.5rpx}.experience-option-description{font-size:22rpx;line-height:30rpx;letter-spacing:.4rpx;margin-top:2rpx;white-space:pre-wrap}
.slots-sheet .experience-options .experience-toggle.selected{background:#fff;border-color:#1A1A1A;color:#1A1A1A}
/* Booking result typography follows PDF page 4. */
.registration-success{padding:30rpx 50rpx 50rpx;background:#fff;color:#1A1A1A}
.registration-success .success-heading .title,.registration-success .success-event-name{font-size:54rpx;line-height:70rpx;font-weight:700;letter-spacing:.8rpx;margin:0 0 16rpx;overflow-wrap:break-word}
.registration-success .success-event-name{color:#9E9E9E}.registration-success .success-heading .muted{font-size:30rpx;line-height:44rpx;font-weight:500;letter-spacing:.5rpx;color:#9E9E9E;margin-top:24rpx}
.registration-success .section-title{font-size:36rpx;font-weight:500;line-height:50rpx;letter-spacing:.6rpx;margin:32rpx 0 20rpx;color:#1A1A1A}
.registration-success .ticket{margin-top:0;border:1rpx solid #E7E7E7;border-radius:12rpx;padding:24rpx 22rpx 0}
.registration-success .ticket .event-title,.registration-success .ticket .section-title{font-size:30rpx;line-height:44rpx;font-weight:500;letter-spacing:.5rpx;color:#1A1A1A}
.registration-success .ticket-line{font-size:24rpx;font-weight:400;line-height:36rpx;letter-spacing:.5rpx;padding:8rpx 0;color:#9E9E9E;align-items:flex-start}.registration-success .ticket-line text:last-child{color:#9E9E9E;white-space:pre-wrap;overflow-wrap:break-word}
.registration-success .description,.body .description{font-size:24rpx;font-weight:400;line-height:40rpx;letter-spacing:.5rpx;color:#9E9E9E;white-space:pre-wrap}
.registration-success .description-heading,.body .description-heading{font-weight:500;color:#1A1A1A}
.registration-success .ticket-actions{border-color:#E7E7E7;margin-top:24rpx}.registration-success .ticket-actions button{font-size:36rpx;font-weight:400;letter-spacing:.6rpx;line-height:50rpx;padding:20rpx 0;color:#9E9E9E;border-color:#E7E7E7}
.registration-success .gold-button{background:#EEE7D9;color:#1A1A1A}.success-contact .muted{color:#9E9E9E;font-size:24rpx;line-height:36rpx}
/* Form and success dialog: PDF page 3. */
.registration-page{color:#1A1A1A}.registration-page>.title{font-size:44rpx;font-weight:700;line-height:60rpx;letter-spacing:.6rpx}
.registration-event{border-color:#E7E7E7}.registration-event .event-title,.registration-event .subtitle{font-size:30rpx;line-height:44rpx;letter-spacing:.5rpx;font-weight:500;color:#1A1A1A}.registration-event .meta,.registration-event .event-desc{font-size:22rpx;line-height:36rpx;letter-spacing:.4rpx}.registration-event .event-desc{color:#9E9E9E}
.registration-selection{font-size:24rpx;line-height:36rpx;letter-spacing:.5rpx;color:#9E9E9E;white-space:pre-wrap}
.registration-page .field{font-size:30rpx;line-height:44rpx;letter-spacing:.5rpx;color:#1A1A1A}.registration-page .field input,.registration-page .picker{font-size:30rpx;letter-spacing:.5rpx;color:#1A1A1A;border-color:#E7E7E7}.registration-input-placeholder{font-size:30rpx;letter-spacing:.5rpx;color:#9E9E9E}
.registration-page .consent{font-size:24rpx;line-height:40rpx;letter-spacing:.5rpx;color:#9E9E9E}.link{color:#9E9E9E}
.registration-page .phone-authorize-button{background:#fff;border-color:#E7E7E7;color:#1A4D3F;font-size:24rpx;letter-spacing:.5rpx}
.booking-success-dialog{color:#1A1A1A;border-radius:24rpx}.booking-success-dialog .booking-success-close{width:auto;min-width:0;max-width:none;font-size:36rpx;line-height:50rpx;font-weight:400;letter-spacing:.6rpx;color:#9E9E9E}
.booking-success-check{background:#1A4D3F}.booking-success-title{font-size:36rpx;font-weight:500;line-height:50rpx;letter-spacing:.6rpx}.booking-success-note{color:#9E9E9E;font-size:24rpx;line-height:36rpx;padding:0 24rpx}
.booking-success-actions,.booking-success-actions button+button{border-color:#E7E7E7}.booking-success-actions button{font-size:36rpx;line-height:50rpx;font-weight:400;letter-spacing:.6rpx;padding:22rpx 8rpx;color:#1A1A1A;min-width:0}
/* Match the shared palette on the remaining pages. */
.mine .title,.body .title{color:#1A1A1A}.mine .tabs{gap:10rpx;flex-wrap:wrap}.mine .tabs button{font-size:24rpx;letter-spacing:.5rpx;min-width:100rpx}.booking{border-color:#E7E7E7}.booking-link{border-color:#E7E7E7;color:#1A4D3F}.ticket-code,.ticket-code-hint,.empty{color:#9E9E9E}.ticket-code>text{color:#1A1A1A}.legal-body{font-size:30rpx;line-height:48rpx;letter-spacing:.5rpx;color:#1A1A1A}

.launch-screen{background:#EEE7D9}.body .section-title{font-size:36rpx;line-height:50rpx;letter-spacing:.6rpx;font-weight:500;color:#1A1A1A}.description-line{display:block;min-height:40rpx}

/* Designer-supplied @3x slices, displayed at their logical design size. */
.meta-icon{display:inline-block;width:32rpx;height:32rpx;margin-right:6rpx;vertical-align:middle}
.tabbar .tab-icon{width:42rpx;height:44rpx}
.booking-success-dialog .booking-success-check{display:block;width:144rpx;height:144rpx;background:transparent;border:0;border-radius:0;padding:0}

/* Stack each experience with its time options below the shared date. */
.experience-schedule-list{margin-top:32rpx}
.experience-schedule+.experience-schedule{margin-top:40rpx}
.experience-schedule .experience-options{margin-top:0;padding-bottom:0}
.slots-sheet .experience-schedule .section-title{margin-top:24rpx}
.experience-schedule .choices{display:flex;flex-wrap:wrap}
.slots-sheet .experience-schedule .choices button{flex:none;width:calc((100% - 24rpx) / 3);margin:0}

.slots-sheet .choices button{white-space:nowrap;font-size:22rpx;letter-spacing:0;padding-left:2rpx;padding-right:2rpx}

.booking-experience+.booking-experience{border-top:1rpx solid #E7E7E7;margin-top:16rpx;padding-top:16rpx}.booking-siblings{border-bottom:1rpx solid #E7E7E7;margin-bottom:32rpx;padding-bottom:16rpx}.booking-siblings .plain-button{font-size:24rpx;line-height:38rpx;text-align:left;white-space:normal}

/* Booking confirmation reference: centered result and equal-width actions. */
.booking-success-dialog{width:600rpx;max-width:calc(100vw - 64rpx);padding-top:100rpx}
.booking-success-dialog .booking-success-close{font-size:30rpx;line-height:42rpx}
.booking-success-actions button{width:50%;max-width:50%;white-space:nowrap}
/* Long registration page from the supplied reference. */
.registration-success{padding:0 0 calc(40rpx + env(safe-area-inset-bottom))}
.success-hero{width:100%;background:#E7E7E7}.success-hero image{display:block;width:100%;height:auto}.success-hero-placeholder{height:570rpx}
.success-content{padding:64rpx 50rpx 0}
.registration-success .success-heading .title{margin-bottom:18rpx}
.registration-success .success-event-name{margin-bottom:28rpx}
.arrival-row{display:flex;justify-content:space-between;align-items:center;gap:24rpx;padding-bottom:28rpx;border-bottom:1rpx solid #E7E7E7}
.registration-success .arrival-row .muted{margin:0;font-size:30rpx;line-height:38rpx;letter-spacing:.5rpx}
.qr-entry{flex-shrink:0;margin:0;padding:0;width:106rpx;height:106rpx;min-width:106rpx;background:transparent;border-radius:0;line-height:1}.qr-entry image{width:100%;height:100%;display:block}
.registration-success .ticket{box-shadow:0 3rpx 14rpx rgba(0,0,0,.04);border-color:#F2F2F2;border-radius:14rpx;padding:28rpx 28rpx 0}
.registration-success .ticket .event-title{margin:0 0 24rpx}
.success-experience+.success-experience{margin-top:24rpx;padding-top:24rpx;border-top:1rpx solid #E7E7E7}
.success-experience .participation-name{font-size:30rpx;line-height:44rpx;margin-bottom:8rpx}.success-experience .experience-name{font-size:26rpx;line-height:38rpx;white-space:pre-wrap;margin-bottom:6rpx}
.success-experience .meta{font-size:24rpx;line-height:36rpx;margin:0;color:#9E9E9E}
.registration-success .ticket .section-title{margin:24rpx 0 4rpx}.registration-success .ticket-line{padding:2rpx 0}
.experience-reschedule{padding:8rpx 0;margin:8rpx 0 0;width:auto;text-align:left;font-size:24rpx;line-height:36rpx;background:transparent;color:#9E9E9E}
.registration-success .ticket-actions{margin:28rpx -28rpx 0}.registration-success .ticket-actions button{font-size:30rpx;line-height:44rpx}
.registration-success .long-section-title{margin-top:64rpx}
.registration-success .success-contact{margin-top:96rpx;text-align:center}.registration-success .success-contact>image{display:block;width:320rpx;height:320rpx;margin:0 auto 28rpx}.registration-success .success-contact .muted{font-size:34rpx;line-height:48rpx}
.registration-success .success-contact .gold-button{width:100%;margin-top:150rpx;height:112rpx;display:flex;align-items:center;justify-content:center;font-size:36rpx}
.ticket-qr-mask{position:fixed;inset:0;z-index:40;background:rgba(0,0,0,.4);display:flex;align-items:center;justify-content:center}
.ticket-qr-dialog{width:650rpx;max-height:85vh;box-sizing:border-box;padding:30rpx;background:white;border-radius:24rpx;text-align:center}.ticket-qr-dialog .sheet-header{display:flex;justify-content:space-between;font-size:30rpx;margin-bottom:16rpx}.ticket-qr-scroll{max-height:70vh}.ticket-qr-dialog .qr{display:block;margin:20rpx auto}.ticket-qr-dialog .ticket-code{font-size:22rpx;word-break:break-all}.ticket-qr-dialog .plain-button{font-size:24rpx;line-height:36rpx;white-space:normal}

.registration-success .ticket>.participation-name{font-size:30rpx;line-height:44rpx;margin-bottom:12rpx}

.contact-qr-hint{margin-top:16rpx;font-size:24rpx;line-height:36rpx;color:#9E9E9E;text-align:center}

/* My activities uses the same carousel and editorial rows as the home page. */
.mine.mine-list-page{padding:0;min-height:calc(100vh - 130rpx)}
.mine-list-page .mine-carousel-placeholder{height:580rpx;background:#E7E7E7}
.mine-list-page .tabs{padding:40rpx 50rpx 24rpx;gap:20rpx;flex-wrap:nowrap}
.mine-list-page .tabs button{flex:1;min-width:0}
.mine-list-page .mine-event{align-items:flex-start;margin-top:16rpx;padding-bottom:36rpx}
.mine-cover-placeholder{width:270rpx;height:360rpx;flex-shrink:0;background:#E7E7E7}
.mine-list-page .event-cover-image{width:270rpx;height:360rpx;flex-shrink:0}
.mine-list-page .event-title,.mine-list-page .subtitle{font-size:34rpx;line-height:46rpx;letter-spacing:.5rpx}
.mine-list-page .event-desc{font-size:22rpx;line-height:32rpx;-webkit-line-clamp:4;margin-bottom:10rpx}
.mine-list-page .mine-badge-inactive{background:#EEE;color:#9E9E9E}

/* Compact booking sheet heading and participation guidance. */
.slots-sheet .sheet-header{font-size:36rpx;font-weight:400;line-height:50rpx;letter-spacing:0;margin-bottom:12rpx;flex-shrink:0}
.slots-sheet .sheet-header .close{font-size:32rpx;font-weight:400;line-height:50rpx}
.slots-sheet .slot-header-note{font-size:22rpx;font-weight:400;line-height:34rpx;letter-spacing:0;color:#9E9E9E;padding-bottom:24rpx;margin-bottom:0;border-bottom:1rpx solid #E7E7E7;flex-shrink:0}

.image-placeholder{background:#E7E7E7;flex-shrink:0}.detail-image-placeholder{width:100%;height:570rpx;background:#E7E7E7}

.birthday-clear{display:block;margin-top:8rpx;color:#9E9E9E;font-size:24rpx;line-height:36rpx}
