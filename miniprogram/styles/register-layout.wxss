.registration-page{padding:12rpx 50rpx calc(28rpx + env(safe-area-inset-bottom));color:#111}
.registration-page>.title{font-size:42rpx;font-weight:600;margin:12rpx 0 36rpx}
.registration-event{display:flex;align-items:stretch;gap:28rpx;padding-bottom:28rpx;border-bottom:1rpx solid #e6e6e6}
.registration-event .cover{width:270rpx;min-height:330rpx}
.registration-event .event-title{font-size:28rpx;margin:8rpx 0}
.registration-event .event-desc{font-size:22rpx;-webkit-line-clamp:3;margin-bottom:12rpx}
.registration-event .meta{font-size:21rpx;line-height:1.5}
.registration-selection{font-size:22rpx;color:#8f9987;margin:20rpx 0}
.registration-page .field{color:#111;font-size:28rpx;margin:28rpx 0}
.registration-page .field input,.registration-page .picker{border-color:#e2e2e2;border-radius:0;color:#999;height:88rpx;font-size:26rpx}
.registration-page .consent{font-size:23rpx;color:#a0a0a0}
.registration-page .booking-submit{margin-top:30rpx}
.registration-error{padding:24rpx;background:#fff3e3;color:#956b39;line-height:1.8}
.registration-selection{color:#777}

.booking-success-mask{position:fixed;inset:0;z-index:30;background:rgba(0,0,0,.38);display:flex;align-items:center;justify-content:center}.booking-success-dialog{position:relative;width:660rpx;border-radius:30rpx;background:white;overflow:hidden;text-align:center;color:#111;padding-top:100rpx}.booking-success-close{position:absolute;right:22rpx;top:18rpx;padding:8rpx 12rpx;margin:0;background:transparent;color:#aaa;font-size:26rpx;font-weight:400;line-height:1.5}.booking-success-check{width:144rpx;height:144rpx;border-radius:50%;background:#005b48;color:white;font-size:100rpx;line-height:144rpx;margin:20rpx auto 36rpx}.booking-success-title{font-size:36rpx;margin-bottom:78rpx}.booking-success-note{font-size:24rpx;color:#888;margin:-50rpx 0 40rpx}.booking-success-actions{display:flex;border-top:1rpx solid #eee}.booking-success-actions button{flex:1;border-radius:0;background:white;color:#111;font-size:30rpx;padding:30rpx 0;margin:0}.booking-success-actions button+button{border-left:1rpx solid #eee}

/* Keep native input text, placeholder and caret on the same baseline. */
.registration-page .field input{padding:0 23rpx;height:88rpx;line-height:88rpx;box-sizing:border-box;color:#111;font-size:26rpx}.registration-input-placeholder{color:#999;font-size:26rpx;line-height:88rpx}

.registration-phone-row{display:flex;align-items:center;gap:16rpx;margin-top:12rpx}
.registration-page .field .registration-phone-row input{flex:1;width:0;min-width:0;margin:0;padding:0 18rpx}
.registration-page .phone-authorize-button{flex-shrink:0;width:auto;min-width:0;height:88rpx;margin:0;padding:0 16rpx;display:flex;align-items:center;justify-content:center;white-space:nowrap;background:#f0f4ed;border:1rpx solid #dce5d8;border-radius:6rpx;color:#496b48;font-size:23rpx;font-weight:500;line-height:1.4}
